<?xml version="1.0" encoding="utf-8"?>
<!-- overlay_layout.xml: Main overlay (bottom-center subtitle + pause control panel) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <!-- Control Panel: shown only when paused via subtitle click -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Speed Spinner Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed:"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/overlaySpinnerSpeed"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#AAFFFFFF" />
        </LinearLayout>

        <!-- Time Slider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time:"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <SeekBar
                android:id="@+id/overlaySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressTint="#4CAF50"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/overlayTextTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00.000"
                android:textColor="#FFFF00"
                android:textSize="11sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Font Size Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font:"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/overlayEditFontSize"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="20"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#44FFFFFF"
                android:padding="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginStart="3dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main row: Subtitle text + move-up button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/textViewOverlaySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Subtitle Overlay]"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:padding="4dp"
            android:background="#1A000000"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <!-- Green move-up button -->
        <View
            android:id="@+id/buttonMoveUp"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#4CAF50"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Move overlay up" />

    </LinearLayout>

</LinearLayout>
